###
### Helgrind
###

{
   mythread_wrapper
   Helgrind:Race
   obj:*libfuse*.so*
   obj:*libfuse*.so*
   obj:*libfuse*.so*
   obj:*libfuse*.so*
   fun:mythread_wrapper
   fun:start_thread
   fun:clone
}

