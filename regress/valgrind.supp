   fun:mutex_destroy_WRK
   fun:fuse_session_destroy
   fun:fuse_destroy
   fun:fuse_main_real_versioned
   fun:fuse_main_fn
   fun:gfarm2fs_fuse_main
   fun:main
}

{
   session-mutex-destroy-2
   Helgrind:Misc
   fun:mutex_destroy_WRK
   fun:pthread_mutex_destroy
   obj:*libp11-kit.so*
   fun:_dl_fini
   fun:__run_exit_handlers
   fun:exit
   fun:(below main)
}

